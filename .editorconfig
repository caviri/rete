# Editor defaults for the repo. This project is Linux-first and LF-only
# (see .gitattributes); these rules stop editors on any OS — notably Windows —
# from drifting files back to CRLF or trailing whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{rs,toml}]
indent_size = 4

[*.{js,css,html,json,yml,yaml,md,sh,py}]
indent_size = 2

# Markdown: trailing spaces can be meaningful (hard line breaks).
[*.md]
trim_trailing_whitespace = false

# Makefiles require real tabs.
[Makefile]
indent_style = tab
