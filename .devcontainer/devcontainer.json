{
  "name": "rete",
  "dockerComposeFile": "../compose.yaml",
  "service": "dev",
  "workspaceFolder": "/work",
  "runServices": ["dev"],
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  }
}
