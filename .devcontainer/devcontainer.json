{
  "name": "rete",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  },
  "mounts": [
    "source=rete-cargo-cache,target=/usr/local/cargo/registry,type=volume"
  ],
  "postCreateCommand": "cargo --version && rustc --version && cargo fmt --version && cargo clippy --version && python3 --version && wasm-pack --version"
}
