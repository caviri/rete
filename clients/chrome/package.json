{
  "name": "retelens",
  "private": true,
  "version": "0.0.0",
  "description": "Retelens: a Chrome extension that opens .rete graph files where they are hosted (Hugging Face, GitHub, Zenodo, any URL).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-timeout=300000 test/*.test.mjs"
  },
  "dependencies": {
    "cytoscape": "3.30.4",
    "cytoscape-dagre": "2.5.0",
    "cytoscape-fcose": "2.2.0",
    "d3-chord": "3.0.1",
    "d3-shape": "3.2.0",
    "dagre": "0.8.5",
    "graphology": "0.25.4",
    "graphology-communities-louvain": "2.0.1",
    "leaflet": "1.9.4",
    "pmtiles": "3.2.1",
    "protomaps-leaflet": "5.1.0"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "playwright": "1.49.0"
  }
}
