<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.caviri</groupId>
    <artifactId>rete-parent</artifactId>
    <version>0.3.0</version>
  </parent>

  <artifactId>rete-client</artifactId>
  <packaging>jar</packaging>

  <name>rete-client</name>
  <description>Pure-Java rete client: the wasm engine run in the JVM via Chicory (no JNI, no native lib).</description>

  <dependencies>
    <!-- Native-JVM WebAssembly runtime. `runtime` pulls in the `wasm` module
         parser transitively; it is declared explicitly too since we call
         com.dylibso.chicory.wasm.Parser directly. -->
    <dependency>
      <groupId>com.dylibso.chicory</groupId>
      <artifactId>runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>com.dylibso.chicory</groupId>
      <artifactId>wasm</artifactId>
    </dependency>
    <!-- Compiles the engine to JVM bytecode at load time instead of
         interpreting it. Not optional: the interpreter is several times slower,
         so a default install should get the fast path. Excluding this artifact
         still works — Rete falls back to the interpreter with a warning. -->
    <dependency>
      <groupId>com.dylibso.chicory</groupId>
      <artifactId>compiler</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The execution mode is resolved once per JVM, so the interpreter
           branch needs a second, separate test JVM. This keeps the documented
           escape hatch (-Drete.chicory.interpreter=true) covered by CI. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>interpreter</id>
            <phase>test</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <includes><include>**/ExecutionModeTest.java</include></includes>
              <systemPropertyVariables>
                <rete.chicory.interpreter>true</rete.chicory.interpreter>
              </systemPropertyVariables>
              <!-- Surefire reuses one report directory per module; give this
                   run its own so it does not overwrite the default run's. -->
              <reportsDirectory>${project.build.directory}/surefire-reports-interpreter</reportsDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
