<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.caviri</groupId>
    <artifactId>rete-parent</artifactId>
    <version>0.3.0</version>
  </parent>

  <artifactId>rete-rdf4j</artifactId>
  <packaging>jar</packaging>

  <name>rete-rdf4j</name>
  <description>RDF4J binding for rete: a read-only Sail/Repository over a .rete image.</description>

  <dependencies>
    <!-- The wasm engine wrapper (this reactor's core module). -->
    <dependency>
      <groupId>io.github.caviri</groupId>
      <artifactId>rete-client</artifactId>
    </dependency>

    <!-- Sail SPI: AbstractSail, AbstractSailConnection, SailReadOnlyException. -->
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-sail-api</artifactId>
    </dependency>
    <!-- SPARQL evaluation over a TripleSource: DefaultEvaluationStrategy etc. -->
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-queryalgebra-evaluation</artifactId>
    </dependency>
    <!-- SimpleValueFactory / model types. -->
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-model</artifactId>
    </dependency>
    <!-- NTriplesUtil (org.eclipse.rdf4j.rio.helpers): the term ⇄ string mapping
         shared with the engine. Lives in rdf4j-rio-api. -->
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-rio-api</artifactId>
    </dependency>
    <!-- SailRepository, the high-level Repository over a Sail. -->
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-repository-sail</artifactId>
    </dependency>
    <!-- Parse rete's result envelope (JSON) in the ReteEngine fast-path. Already
         on the classpath via RDF4J; declared explicitly to guarantee it at compile. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Registers the SPARQL parser so SailRepository.prepareTupleQuery works
         (ServiceLoader-discovered); needed at runtime by any consumer. -->
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-queryparser-sparql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
