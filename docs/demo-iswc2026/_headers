# Cloudflare Pages response headers for demo.graphplaza.com.
#
# Deliberately NO Cross-Origin-Opener/Embedder-Policy at the site level: the
# console only wants cross-origin isolation when a visitor opts in with
# ?parallel=1, and it gets there through its own service worker
# (/playground/coi-serviceworker.js, scoped to /playground/). Setting COEP
# globally would instead break the JupyterLite station, which loads the Pyodide
# runtime from a CDN that sends no CORP header.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# The extension bundle: a zip under another name. Force a download rather than
# letting a browser guess, and name the saved file predictably.
/agent/rete-demo.mcpb
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="rete-demo.mcpb"

# The stylesheet and scripts must never be older than the HTML that references
# them. A 24-hour max-age here once paired new markup with a day-old stylesheet
# and the page rendered without its layout — so these revalidate every time, and
# their URLs additionally carry a content hash (dev/demo/build/stamp_assets.py).
/assets/*.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/*.js
  Cache-Control: public, max-age=0, must-revalidate
# Screenshots change only when the build does, and are hash-free, so keep them
# cheap but still revalidating.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
/paper/*
  Cache-Control: public, max-age=3600, must-revalidate

# The console is one 6.4 MB document; let a returning visitor revalidate rather
# than re-download it.
/playground/index.html
  Cache-Control: public, max-age=3600, must-revalidate
