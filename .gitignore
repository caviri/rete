# Build output
/target
/web/pkg*
# Local skill activation: junctions/symlinks pointing at the committed skills/ dir.
# The skills themselves live (tracked) under /skills; these are a per-machine
# convenience so Claude Code discovers them — re-create with skills/README.md.
/.claude/skills/
# CodeMirror 6 bundle deps — the built cm6.bundle.js IS committed (inlined by
# build_playground.py); rebuild with cm6/package.json. node_modules is not.
/web/playground-src/cm6/node_modules/
**/*.rs.bk
.venv/
__pycache__/
# Built static pages rendered by scripts/build_playground.py (docs/ copies are
# committed; the web/ copy is a local-serving convenience, regenerated).
/web/explore-100mb.html
/web/atlas-app.html

# Built graph files are artifacts of the .nt/.nq sources in examples/ — rebuild
# with `rete build` (see README). The sources, not the binaries, are tracked.
*.rete
!crates/rete-core/tests/fixtures/**/*.rete
# Vector-tile basemaps (tippecanoe) paired with a dataset live only in the bucket.
*.pmtiles
*.mbtiles
# …and the tiny causal ontology the explorer's Coherence tasks check, same-origin
# (it carries OWL axioms the wikidata graph lacks). Rebuild with:
#   rete build examples/causal.nt -o docs/examples/causal.rete
!/docs/examples/causal.rete
# …and the bundled dataset cards the Plaza gallery reads live over HTTP range on
# GitHub Pages (assembled from web/*.rete by scripts/build_plaza.py).
!/docs/plaza/data/*.rete

# Cargo.lock IS committed: this workspace ships a binary (rete-cli), so a locked
# dependency set gives reproducible builds and a stable CI cache key. (It would
# be omitted only for a library-only crate.)

# Claude Code local runtime state (machine-local, not shareable config)
.claude/scheduled_tasks.lock
.claude/settings.local.json


# Generated datasets (regenerate with scripts/fetch_opencitations.py).
# Ignore the *contents* (not the dir itself) so the catalog README can be re-included.
/data/*
!/data/README.md

# Local engineering notes / scratch plans — not part of the published repo.
/dev/

# Local secrets (JWT_TOKEN etc.) — never commit.
.env

# graph-map experiment: track the code (Dockerfile/build_map.py/viewer.html),
# not the generated tiles/logs. Regenerate with experiments/graph-map/README.md.
/experiments/graph-map/out/
/experiments/graph-map/_*.log
/experiments/graph-map/_*.json
/experiments/graph-map/_*.err
/experiments/graph-map/node_modules/
# lance-rag experiment: track the code, not the generated Lance dataset / graph.
/experiments/lance-rag/out/
/experiments/lance-rag/models/

# W3C SPARQL test suite, cloned locally for conformance runs (scripts/sparql_conformance.py)
/rdf-tests/
# Locally-built rete binary used by the conformance harness
/rete-bin
# Docker cargo cache (CARGO_HOME mounted into the rust image for docgen/builds)
/.cargo-home/
target-star/
target-std/
target-wasm/
tests/gate/.cache/
tests/gate/node_modules/
