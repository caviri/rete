# Normalize line endings: this repository is Linux-first and LF-only.
# Git stores LF and checks out LF on every platform, so Windows checkouts stop
# warning "LF will be replaced by CRLF" and diffs stay clean regardless of
# contributor OS or core.autocrlf.
* text=auto eol=lf

# Source and text formats: explicit LF.
*.rs         text eol=lf
*.toml       text eol=lf
*.lock       text eol=lf
*.md         text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.js         text eol=lf
*.py         text eol=lf
*.sh         text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.svg        text eol=lf
*.nt         text eol=lf
*.nq         text eol=lf
*.ttl        text eol=lf

# Linux/container entry points.
Dockerfile   text eol=lf
*.Dockerfile text eol=lf
.devcontainer/** text eol=lf

# Built graph files are binary artifacts (also gitignored): never normalize or
# diff them as text.
*.rete  binary

# Generated/runtime binary assets.
*.wasm  binary
*.whl   binary
*.mcpb  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.pyc   binary

# Lockfile is committed and machine-generated; keep it out of language stats and
# review diffs by default.
Cargo.lock linguist-generated=true

# Generated social previews (scripts/preview/): review them as build artifacts,
# not as source — they are regenerated wholesale, never hand-edited.
docs/q/**                linguist-generated=true
docs/d/**                linguist-generated=true
docs/og/**               linguist-generated=true
docs/shared.html         linguist-generated=true
docs/preview.css         linguist-generated=true
web/preview/answers.json linguist-generated=true
