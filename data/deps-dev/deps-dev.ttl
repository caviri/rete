@prefix deps:    <https://w3id.org/rete/deps-dev#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema:  <https://schema.org/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

#################################################################
#  Ontology header
#################################################################
deps: a owl:Ontology ;
    dcterms:title "deps.dev (Open Source Insights) ontology"@en ;
    dcterms:description "A cross-ecosystem graph of open-source package versions, their version-pinned dependency relations, source projects, and security advisories, derived from Google's deps.dev BigQuery public dataset."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://deps.dev/> ;
    owl:versionInfo "1.0.0 (snapshot 2026-07-13)" ;
    rdfs:seeAlso <https://docs.deps.dev/bigquery/v1/> .

#################################################################
#  Classes
#################################################################
deps:PackageVersion a owl:Class ;
    rdfs:subClassOf schema:SoftwareApplication ;
    rdfs:label "Package version"@en ;
    rdfs:comment "A specific published version of a package in a registry (npm, Go, Maven, PyPI, Cargo, NuGet, RubyGems). Instance IRI = its deps.dev page, e.g. https://deps.dev/npm/lodash/4.17.21 ; the cross-registry join key is deps:purl."@en .

deps:Project a owl:Class ;
    rdfs:subClassOf schema:SoftwareSourceCode ;
    rdfs:label "Project"@en ;
    rdfs:comment "A source repository / project a package is built from (e.g. a GitHub repo). Instance IRI = the repository URL."@en .

deps:Advisory a owl:Class ;
    rdfs:label "Security advisory"@en ;
    rdfs:comment "A security advisory affecting one or more package versions (source GHSA, OSV, NSWG). Instance IRI = its source URL."@en .

#################################################################
#  Object properties
#################################################################
deps:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on"@en ;
    rdfs:comment "The subject package version directly depends on the object package version (resolved, version-pinned, MinimumDepth = 1 in deps.dev)."@en ;
    rdfs:domain deps:PackageVersion ;
    rdfs:range  deps:PackageVersion ;
    owl:inverseOf deps:dependencyOf .

deps:dependencyOf a owl:ObjectProperty ;
    rdfs:label "is dependency of"@en ;
    rdfs:comment "Inverse of deps:dependsOn — the 'dependents' direction. ?x deps:dependencyOf V lists the versions that directly depend on V."@en ;
    rdfs:domain deps:PackageVersion ;
    rdfs:range  deps:PackageVersion .

deps:hasProject a owl:ObjectProperty ;
    rdfs:label "has project"@en ;
    rdfs:comment "Links a package version to its source project / repository."@en ;
    rdfs:domain deps:PackageVersion ;
    rdfs:range  deps:Project .

deps:hasAdvisory a owl:ObjectProperty ;
    rdfs:label "has advisory"@en ;
    rdfs:comment "A security advisory that affects this package version."@en ;
    rdfs:domain deps:PackageVersion ;
    rdfs:range  deps:Advisory ;
    owl:inverseOf deps:affects .

deps:affects a owl:ObjectProperty ;
    rdfs:label "affects"@en ;
    rdfs:domain deps:Advisory ;
    rdfs:range  deps:PackageVersion .

#################################################################
#  Datatype / annotation properties — package versions
#################################################################
deps:system a owl:DatatypeProperty ;
    rdfs:label "registry system"@en ;
    rdfs:comment "The registry/ecosystem: NPM, GO, MAVEN, PYPI, CARGO, NUGET, RUBYGEMS."@en ;
    rdfs:domain deps:PackageVersion ; rdfs:range xsd:string .

deps:packageName a owl:DatatypeProperty ;
    rdfs:subPropertyOf schema:name ;
    rdfs:label "package name"@en ;
    rdfs:domain deps:PackageVersion ; rdfs:range xsd:string .

deps:purl a owl:DatatypeProperty ;
    rdfs:subPropertyOf schema:identifier ;
    rdfs:label "purl"@en ;
    rdfs:comment "Package URL (purl) identifier, e.g. pkg:npm/lodash@4.17.21 — the canonical cross-registry / cross-dataset join key."@en ;
    rdfs:domain deps:PackageVersion ; rdfs:range xsd:string .

deps:registry a owl:DatatypeProperty ;
    rdfs:label "registry URL"@en ;
    rdfs:comment "Base URL of the registry the version is published to (empty for Go, which uses the module proxy)."@en ;
    rdfs:domain deps:PackageVersion ; rdfs:range xsd:anyURI .

deps:isRelease a owl:DatatypeProperty ;
    rdfs:label "is release"@en ;
    rdfs:comment "True if this version is a stable release (not a pre-release)."@en ;
    rdfs:domain deps:PackageVersion ; rdfs:range xsd:boolean .

deps:versionOrdinal a owl:DatatypeProperty ;
    rdfs:label "version ordinal"@en ;
    rdfs:comment "deps.dev's ordering index of this version within its package (higher = newer)."@en ;
    rdfs:domain deps:PackageVersion ; rdfs:range xsd:integer .

deps:slsaVerified a owl:DatatypeProperty ;
    rdfs:label "SLSA provenance verified"@en ;
    rdfs:domain deps:PackageVersion ; rdfs:range xsd:boolean .

deps:slsaSourceRepository a owl:DatatypeProperty ;
    rdfs:label "SLSA source repository"@en ;
    rdfs:domain deps:PackageVersion ; rdfs:range xsd:anyURI .

#################################################################
#  Datatype properties — projects
#################################################################
deps:starsCount a owl:DatatypeProperty ;
    rdfs:label "stars count"@en ;
    rdfs:domain deps:Project ; rdfs:range xsd:integer .

deps:forksCount a owl:DatatypeProperty ;
    rdfs:label "forks count"@en ;
    rdfs:domain deps:Project ; rdfs:range xsd:integer .

deps:openIssuesCount a owl:DatatypeProperty ;
    rdfs:label "open issues count"@en ;
    rdfs:domain deps:Project ; rdfs:range xsd:integer .

deps:ossFuzzLineCoverCount a owl:DatatypeProperty ;
    rdfs:label "OSS-Fuzz lines covered"@en ;
    rdfs:domain deps:Project ; rdfs:range xsd:integer .

#################################################################
#  Datatype properties — advisories
#################################################################
deps:advisorySource a owl:DatatypeProperty ;
    rdfs:label "advisory source"@en ;
    rdfs:comment "GHSA, OSV, NSWG, etc."@en ;
    rdfs:domain deps:Advisory ; rdfs:range xsd:string .

deps:severity a owl:DatatypeProperty ;
    rdfs:label "severity"@en ;
    rdfs:domain deps:Advisory ; rdfs:range xsd:string .

deps:cvss3Score a owl:DatatypeProperty ;
    rdfs:label "CVSS v3 score"@en ;
    rdfs:domain deps:Advisory ; rdfs:range xsd:decimal .

deps:alias a owl:DatatypeProperty ;
    rdfs:subPropertyOf skos:altLabel ;
    rdfs:label "advisory alias"@en ;
    rdfs:comment "An alternate identifier for the advisory, e.g. a CVE id."@en ;
    rdfs:domain deps:Advisory ; rdfs:range xsd:string .

# Reused directly (no local subproperty): schema:softwareVersion (version string),
# schema:license (-> SPDX license IRI http://spdx.org/licenses/<id>),
# schema:codeRepository / schema:url (links), schema:datePublished (UpstreamPublishedAt),
# schema:name (project name), dcterms:title / dcterms:description / dcterms:date (advisory).
