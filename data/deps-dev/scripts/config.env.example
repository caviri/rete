# deps.dev BigQuery export — configuration.
# Copy to config.env and fill in your project, OR export these vars in your shell.
#
#   cp data/deps-dev/scripts/config.env.example data/deps-dev/scripts/config.env
#
# config.env is gitignored (data/ is gitignored) — safe for project-specific ids.

# --- required ---
# A GCP project you own with BigQuery enabled. Queries are BILLED to it; the
# network scope below scans ~842 GB, under the free 1 TiB/month tier (~$0).
GCP_PROJECT="your-gcp-project-id"

# Scratch dataset (US) created in your project to hold each query's destination
# table (required for large results; read via the Storage API, dropped after).
BQ_TMP_DATASET="deps_dev_export"

# Host gcloud creds dir, mounted into every container. ADC lives here after
# `gcloud auth application-default login`.
#   Windows : C:/Users/<you>/AppData/Roaming/gcloud
#   macOS/Linux: $HOME/.config/gcloud
GCLOUD_CONFIG_DIR="${GCLOUD_CONFIG_DIR:-$HOME/.config/gcloud}"

# --- scope ---
# NODE/metadata base tables (02_export.sh filters each to one snapshot). The
# dependency+dependents NETWORK comes from 02b_export_edges.sh (direct edges;
# dependents = reverse traversal, so no Dependents table and no 4 TB transitive
# Dependencies needed). Latest-snapshot scan: PackageVersions ~110 GB,
# PackageVersionToProject ~22 GB, Projects/Advisories <1 GB, edges ~709 GB.
TABLES="${TABLES:-PackageVersions Projects Advisories PackageVersionToProject}"

# SNAPSHOT: empty = auto-pick the latest snapshot; set a literal to pin, e.g.
#   SNAPSHOT="2026-07-13 21:01:00.508977+00:00"
SNAPSHOT="${SNAPSHOT:-}"
