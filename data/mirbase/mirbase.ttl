@prefix mb:      <https://w3id.org/rete/mirbase#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix faldo:   <http://biohackathon.org/resource/faldo#> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix fabio:   <http://purl.org/spar/fabio/> .
@prefix schema:  <https://schema.org/> .

#################################################################
#    Ontology
#################################################################

<https://w3id.org/rete/mirbase> a owl:Ontology ;
    dcterms:title "miRBase vocabulary"@en ;
    dcterms:description """A vocabulary for miRBase — the reference catalogue of
published microRNA sequences and annotation: stem-loop precursors, the mature
miRNAs excised from them, precursor families, species, literature and genome
coordinates.

miRBase publishes no ontology of its own, so this one is deliberately thin and
mostly ALIGNMENT: sequence types anchor to the Sequence Ontology, genome
coordinates are FALDO verbatim, species are NCBITaxon IRIs linked with RO
'in taxon', and citations are FaBiO/Dublin Core. Only genuinely miRBase-specific
things (confidence flags, mature offsets on a precursor, withdrawn accessions)
are minted here.

Kept within OWL 2 QL so a query-rewriting reasoner can use it: no transitive,
functional, or cardinality axioms."""@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:source <https://www.mirbase.org/> ;
    dcterms:bibliographicCitation "Kozomara A, Birgaoanu M, Griffiths-Jones S. miRBase: from microRNA sequences to function. Nucleic Acids Res. 2019;47(D1):D155-D162."@en ;
    rdfs:seeAlso <https://www.mirbase.org/> ;
    owl:versionInfo "22.1" .

#################################################################
#    Classes
#################################################################

mb:Feature a owl:Class ;
    rdfs:label "sequence feature"@en ;
    rdfs:comment "A located RNA feature catalogued by miRBase — a stem-loop precursor or a mature miRNA. Exists so that properties shared by both (organism, genomic location, sequence) have one typed domain."@en ;
    rdfs:subClassOf obo:SO_0000110 .          # sequence_feature

mb:StemLoop a owl:Class ;
    rdfs:label "miRNA stem-loop"@en ;
    rdfs:comment "A miRNA hairpin precursor, identified by an MI accession. miRBase's GFF3 files type these as SO:0000647 miRNA_primary_transcript, but note in their own header that the sequence is only the predicted stem-loop portion rather than the full primary transcript — so SO:0001244 pre_miRNA is the accurate parent."@en ;
    rdfs:subClassOf mb:Feature, obo:SO_0001244 .   # pre_miRNA

mb:MatureMiRNA a owl:Class ;
    rdfs:label "mature miRNA"@en ;
    rdfs:comment "A mature microRNA excised from a stem-loop, identified by a MIMAT accession. The same mature can be produced by several stem-loops."@en ;
    rdfs:subClassOf mb:Feature, obo:SO_0000276 .   # miRNA

mb:Family a owl:Class ;
    rdfs:label "miRNA family"@en ;
    rdfs:comment "A miRBase precursor family (MIPF accession) grouping related stem-loops."@en ;
    rdfs:subClassOf skos:Concept .

mb:Species a owl:Class ;
    rdfs:label "species"@en ;
    rdfs:comment "An organism in which miRNAs were catalogued. Instances are NCBITaxon IRIs (http://purl.obolibrary.org/obo/NCBITaxon_9606) wherever miRBase records a taxon id, so the graph joins other biological linked data without any mapping step."@en ;
    rdfs:subClassOf schema:Taxon .

mb:GenomeAssembly a owl:Class ;
    rdfs:label "genome assembly"@en ;
    rdfs:comment "The genome build a set of coordinates is expressed against, e.g. GRCh38, usually with an INSDC/NCBI assembly accession."@en .

mb:ReferenceSequence a owl:Class ;
    rdfs:label "reference sequence"@en ;
    rdfs:comment "A chromosome, scaffold or contig that coordinates are anchored to — the target of faldo:reference. Minted per (assembly-or-species, sequence name) because the same name ('chr1', 'supercont1.1') recurs across organisms."@en .

mb:Placement a owl:Class ;
    rdfs:label "mature placement"@en ;
    rdfs:comment "The placement of ONE mature miRNA on ONE stem-loop, carrying the offsets. Reified because a mature can sit on several stem-loops at different offsets — MIMAT0007005 is at 96..117 on oan-mir-153-1 but 39..60 on oan-mir-153-2 — so the offsets cannot belong to the mature alone."@en .

mb:TranscriptContext a owl:Class ;
    rdfs:label "transcript context"@en ;
    rdfs:comment "The overlap between a stem-loop and a host transcript (exon, intron, 3UTR, 5UTR) as recorded by miRBase. Reified because it carries the transcript identity and the overlap kind together."@en .

mb:DeadEntry a owl:Class ;
    rdfs:label "dead entry"@en ;
    rdfs:comment "A miRBase accession that has been withdrawn, optionally forwarding to the accession that replaced it. NOT asserted disjoint from mb:StemLoop: withdrawn entries keep their MI accession and can still appear in the stem-loop table with a dead flag."@en .

mb:CoordinateSource a owl:Class ;
    rdfs:label "coordinate source"@en ;
    rdfs:comment "Which miRBase distribution a genomic region came from. The two differ in coverage, so a query must be able to tell them apart."@en .

#################################################################
#    Individuals — the two coordinate sources
#################################################################

mb:GFF3 a mb:CoordinateSource ;
    rdfs:label "GFF3 genome coordinates"@en ;
    rdfs:comment "From the 31 curated per-species GFF3 files. Assembly-stamped, and covering BOTH stem-loops and mature miRNAs."@en .

mb:ChromosomeBuild a mb:CoordinateSource ;
    rdfs:label "chromosome build table"@en ;
    rdfs:comment "From the mirna_chromosome_build table. Much broader species coverage (153 species vs 31) but stem-loops only, and with no genome assembly recorded."@en .

#################################################################
#    Object properties
#################################################################

mb:hasMatureProduct a owl:ObjectProperty ;
    rdfs:label "has mature product"@en ;
    rdfs:comment "Links a stem-loop to a mature miRNA excised from it. For the offsets of that excision use mb:maturePlacement."@en ;
    rdfs:domain mb:StemLoop ;
    rdfs:range mb:MatureMiRNA ;
    owl:inverseOf mb:derivesFrom .

mb:derivesFrom a owl:ObjectProperty ;
    rdfs:label "derives from"@en ;
    rdfs:comment "Links a mature miRNA to a stem-loop it is excised from."@en ;
    rdfs:domain mb:MatureMiRNA ;
    rdfs:range mb:StemLoop .

mb:organism a owl:ObjectProperty ;
    rdfs:label "organism"@en ;
    rdfs:comment "The species the sequence was catalogued in."@en ;
    rdfs:domain mb:Feature ;
    rdfs:range mb:Species ;
    rdfs:subPropertyOf obo:RO_0002162 .        # in taxon

mb:family a owl:ObjectProperty ;
    rdfs:label "family"@en ;
    rdfs:comment "The miRBase precursor family of a stem-loop."@en ;
    rdfs:domain mb:StemLoop ;
    rdfs:range mb:Family .

mb:location a owl:ObjectProperty ;
    rdfs:label "location"@en ;
    rdfs:comment "A genomic region giving the coordinates of the feature. A feature commonly has SEVERAL: one per genome copy, and one per coordinate source."@en ;
    rdfs:domain mb:Feature ;
    rdfs:range faldo:Region ;
    rdfs:subPropertyOf faldo:location .

mb:assembly a owl:ObjectProperty ;
    rdfs:label "assembly"@en ;
    rdfs:comment "The genome build referred to. Deliberately has NO rdfs:domain: it is used on regions, on reference sequences and on species, so asserting any one of those would make a reasoner infer the others are that class too."@en ;
    rdfs:range mb:GenomeAssembly .

mb:coordinateSource a owl:ObjectProperty ;
    rdfs:label "coordinate source"@en ;
    rdfs:comment "Which miRBase distribution this region's coordinates came from."@en ;
    rdfs:domain faldo:Region ;
    rdfs:range mb:CoordinateSource .

mb:parentStemLoop a owl:ObjectProperty ;
    rdfs:label "parent stem-loop"@en ;
    rdfs:comment "For a mature miRNA's genomic region, the stem-loop copy it was excised from (the GFF3 Derives_from). Distinct from mb:derivesFrom because it is a property of the REGION, not of the mature: a mature present at several loci has a different parent at each."@en ;
    rdfs:domain faldo:Region ;
    rdfs:range mb:StemLoop .

mb:maturePlacement a owl:ObjectProperty ;
    rdfs:label "mature placement"@en ;
    rdfs:comment "A mature miRNA's placement, with offsets, on this stem-loop."@en ;
    rdfs:domain mb:StemLoop ;
    rdfs:range mb:Placement .

mb:mature a owl:ObjectProperty ;
    rdfs:label "mature"@en ;
    rdfs:comment "The mature miRNA a placement refers to."@en ;
    rdfs:domain mb:Placement ;
    rdfs:range mb:MatureMiRNA .

mb:stemLoop a owl:ObjectProperty ;
    rdfs:label "stem loop"@en ;
    rdfs:comment "The stem-loop a placement refers to."@en ;
    rdfs:domain mb:Placement ;
    rdfs:range mb:StemLoop .

mb:transcriptContext a owl:ObjectProperty ;
    rdfs:label "transcript context"@en ;
    rdfs:comment "A host-transcript overlap recorded for this stem-loop."@en ;
    rdfs:domain mb:StemLoop ;
    rdfs:range mb:TranscriptContext .

mb:forwardTo a owl:ObjectProperty ;
    rdfs:label "forward to"@en ;
    rdfs:comment "The entry that superseded a withdrawn accession."@en ;
    rdfs:domain mb:DeadEntry ;
    rdfs:range mb:StemLoop .

#################################################################
#    Datatype properties
#################################################################

mb:sequence a owl:DatatypeProperty ;
    rdfs:label "sequence"@en ;
    rdfs:comment "The RNA sequence as distributed in the FASTA files (U-form, uppercase)."@en ;
    rdfs:domain mb:Feature ;
    rdfs:range xsd:string .

mb:sequenceLength a owl:DatatypeProperty ;
    rdfs:label "sequence length"@en ;
    rdfs:comment "Length of the sequence in bases."@en ;
    rdfs:domain mb:Feature ;
    rdfs:range xsd:integer .

mb:matureFrom a owl:DatatypeProperty ;
    rdfs:label "mature from"@en ;
    rdfs:comment "1-based start offset of the mature product WITHIN its stem-loop (not a genome coordinate — for those use mb:location). Asserted on an mb:Placement always, and additionally on the mature itself only when that mature has exactly one parent stem-loop, where the value is unambiguous."@en ;
    rdfs:range xsd:integer .

mb:matureTo a owl:DatatypeProperty ;
    rdfs:label "mature to"@en ;
    rdfs:comment "1-based end offset of the mature product within its stem-loop. See mb:matureFrom for when it appears on the mature itself."@en ;
    rdfs:range xsd:integer .

mb:evidence a owl:DatatypeProperty ;
    rdfs:label "evidence"@en ;
    rdfs:comment "miRBase evidence class for a mature product, e.g. 'experimental' or 'not_experimental'."@en ;
    rdfs:domain mb:MatureMiRNA ;
    rdfs:range xsd:string .

mb:experiment a owl:DatatypeProperty ;
    rdfs:label "experiment"@en ;
    rdfs:comment "Free-text description of the experiments supporting a mature miRNA, with bracketed references to the entry's citations."@en ;
    rdfs:domain mb:MatureMiRNA ;
    rdfs:range xsd:string .

mb:similarity a owl:DatatypeProperty ;
    rdfs:label "similarity"@en ;
    rdfs:comment "Accession(s) this entry was annotated by similarity to."@en ;
    rdfs:domain mb:MatureMiRNA ;
    rdfs:range xsd:string .

mb:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:comment "miRBase confidence score (0, 1 or 2); >=1 means the entry meets the high-confidence criteria."@en ;
    rdfs:domain mb:StemLoop ;
    rdfs:range xsd:integer .

mb:highConfidence a owl:DatatypeProperty ;
    rdfs:label "high confidence"@en ;
    rdfs:comment "True when the entry appears in miRBase's high-confidence FASTA subset."@en ;
    rdfs:domain mb:Feature ;
    rdfs:range xsd:boolean .

mb:previousId a owl:DatatypeProperty ;
    rdfs:label "previous id"@en ;
    rdfs:comment "A former miRBase identifier for this entry. Also emitted as skos:altLabel."@en ;
    rdfs:domain mb:Feature ;
    rdfs:range xsd:string .

mb:taxonId a owl:DatatypeProperty ;
    rdfs:label "taxon id"@en ;
    rdfs:comment "NCBI taxonomy id of the species."@en ;
    rdfs:domain mb:Species ;
    rdfs:range xsd:integer .

mb:organismCode a owl:DatatypeProperty ;
    rdfs:label "organism code"@en ;
    rdfs:comment "The 3-4 letter miRBase organism prefix, e.g. 'hsa'. It prefixes every miRNA name in that species."@en ;
    rdfs:domain mb:Species ;
    rdfs:range xsd:string .

mb:taxonomyPath a owl:DatatypeProperty ;
    rdfs:label "taxonomy path"@en ;
    rdfs:comment "miRBase's own semicolon-separated lineage, e.g. 'Metazoa;Chordata;Mammalia;'."@en ;
    rdfs:domain mb:Species ;
    rdfs:range xsd:string .

mb:assemblyAccession a owl:DatatypeProperty ;
    rdfs:label "assembly accession"@en ;
    rdfs:comment "INSDC/NCBI assembly accession of the genome build, e.g. 'NCBI_Assembly:GCA_000001405.15'."@en ;
    rdfs:domain mb:GenomeAssembly ;
    rdfs:range xsd:string .

mb:overlapType a owl:DatatypeProperty ;
    rdfs:label "overlap type"@en ;
    rdfs:comment "How a stem-loop overlaps a host transcript: exon, intron, 3UTR or 5UTR."@en ;
    rdfs:domain mb:TranscriptContext ;
    rdfs:range xsd:string .

mb:overlapSense a owl:DatatypeProperty ;
    rdfs:label "overlap sense"@en ;
    rdfs:comment "Strand sense of the overlap with the host transcript."@en ;
    rdfs:domain mb:TranscriptContext ;
    rdfs:range xsd:string .

mb:transcriptId a owl:DatatypeProperty ;
    rdfs:label "transcript id"@en ;
    rdfs:comment "Host transcript identifier, usually an Ensembl transcript id."@en ;
    rdfs:domain mb:TranscriptContext ;
    rdfs:range xsd:string .

mb:transcriptName a owl:DatatypeProperty ;
    rdfs:label "transcript name"@en ;
    rdfs:comment "Host transcript name."@en ;
    rdfs:domain mb:TranscriptContext ;
    rdfs:range xsd:string .

mb:transcriptSource a owl:DatatypeProperty ;
    rdfs:label "transcript source"@en ;
    rdfs:comment "Source of the host transcript annotation, e.g. 'HGNC_trans_name'."@en ;
    rdfs:domain mb:TranscriptContext ;
    rdfs:range xsd:string .

mb:deadFlag a owl:DatatypeProperty ;
    rdfs:label "dead flag"@en ;
    rdfs:comment "True when miRBase marks the entry withdrawn. Note that mature.fa still ships 25 entries flagged dead, so this is not the same as 'absent from the distribution'."@en ;
    rdfs:domain mb:Feature ;
    rdfs:range xsd:boolean .

mb:sourceRowMalformed a owl:DatatypeProperty ;
    rdfs:label "source row malformed"@en ;
    rdfs:comment "True when miRBase's own relational export has shifted fields for this entry, so some columns are unreliable. Currently MI0023465, whose species column resolves to the wrong organism; the species link is withheld rather than propagated."@en ;
    rdfs:domain mb:Feature ;
    rdfs:range xsd:boolean .

#################################################################
#    Notes on reused terms (all verified to exist)
#################################################################
#
#  obo:SO_0000110   sequence_feature          obo:SO_0001244  pre_miRNA
#  obo:SO_0000276   miRNA                     obo:SO_0000647  miRNA_primary_transcript
#  obo:RO_0002162   in taxon (object property)
#  faldo:Region / ExactPosition / ForwardStrandPosition / ReverseStrandPosition
#  faldo:begin / end / position / reference / location
#  fabio:JournalArticle          — literature entries
#  dcterms:isReferencedBy        — stem-loop -> publication (NOT cito:isReferencedBy,
#                                  which does not exist)
#  dcterms:identifier / title / creator / description / bibliographicCitation / source
#  skos:prefLabel / altLabel / Concept
#  rdfs:seeAlso                  — cross-references to RNAcentral, Rfam, EntrezGene,
#                                  HGNC, MGI
#  schema:Taxon                  — superclass of mb:Species
#
#  No owl:AllDisjointClasses is asserted. mb:DeadEntry and mb:StemLoop share
#  accession IRIs, and disjointness there would make the graph inconsistent.
