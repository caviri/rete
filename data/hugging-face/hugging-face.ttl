@prefix hf:      <https://w3id.org/rete/huggingface#> .
@prefix scholar: <https://w3id.org/rete/scholar#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix org:     <http://www.w3.org/ns/org#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sioc:    <http://rdfs.org/sioc/ns#> .
@prefix schema:  <https://schema.org/> .

#################################################################
#  rete Hugging Face Hub ontology  (prefix hf:)
#
#  Models the public Hugging Face Hub as a scholarly-social graph:
#  accounts (users/organizations), repositories (models, dataset
#  repos, spaces), papers, posts, and the derivation fabric between
#  them (finetuned-from, trained-on, used-in-space, cites-paper),
#  plus the social layer (follows, membership).
#
#  SCHOLAR ALIGNMENT (inline, standalone-usable):
#  hf:Model / hf:DatasetRepo / hf:Space / hf:Paper ⊑ scholar:Work;
#  hf:User ⊑ scholar:Person; hf:Organization ⊑ scholar:Organization;
#  hf:doi ⊑ scholar:doi.  CANONICAL IRIs per the scholar policy:
#    • paper           → https://doi.org/10.48550/arxiv.{arxiv-id}
#      (arXiv DataCite DOI — auto-merges with DataCite/Crossref/
#       OpenAIRE records of the same preprint in a union graph)
#    • account         → https://huggingface.co/{name}
#    • model           → https://huggingface.co/{repo-id}
#    • dataset repo    → https://huggingface.co/datasets/{repo-id}
#    • space           → https://huggingface.co/spaces/{repo-id}
#    • post            → https://huggingface.co/posts/{author}/{slug}
#  (hf.co URLs are the Hub's own stable, dereferenceable IRIs — the
#   "native id" of the else-branch in the scholar policy.)
#
#  OWL 2 QL-safe: subClassOf / subPropertyOf only, no disjointness.
#  Bulky non-graph payloads (cardData JSON, file manifests/siblings,
#  safetensors per-dtype breakdowns, BibTeX citation blobs) stay in
#  the Parquet companions — see data/hugging-face/README.md.
#################################################################

hf: a owl:Ontology ;
  dcterms:title "rete Hugging Face Hub Ontology"@en ;
  dcterms:description "The public Hugging Face Hub as a graph: users, organizations, models, dataset repositories, spaces, papers and posts, with the ML derivation fabric (base-model genealogy, training datasets, space usage, paper citations) and the social network (followers, org membership). Aligned to the rete scholar hub (works/persons/organizations/DOIs)."@en ;
  dcterms:source <https://huggingface.co/> ;
  dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
  rdfs:seeAlso scholar: ;
  owl:versionInfo "1.0.0 (2026-07-27), snapshot 2026-07-23" .

#################################################################
#  CLASSES
#################################################################

hf:User a owl:Class ;
  rdfs:label "Hub user"@en ;
  rdfs:comment "A Hugging Face user account."@en ;
  rdfs:subClassOf scholar:Person , sioc:UserAccount .

hf:Organization a owl:Class ;
  rdfs:label "Hub organization"@en ;
  rdfs:comment "A Hugging Face organization account (company, lab, community)."@en ;
  rdfs:subClassOf scholar:Organization .

hf:Repository a owl:Class ;
  rdfs:label "Hub repository"@en ;
  rdfs:comment "Abstract superclass of the three public repo kinds: model, dataset, space."@en ;
  rdfs:subClassOf schema:CreativeWork .

hf:Model a owl:Class ;
  rdfs:label "ML model"@en ;
  rdfs:comment "A model repository."@en ;
  rdfs:subClassOf hf:Repository , scholar:Work , schema:SoftwareSourceCode .

hf:DatasetRepo a owl:Class ;
  rdfs:label "Dataset repository"@en ;
  rdfs:comment "A dataset repository."@en ;
  rdfs:subClassOf hf:Repository , scholar:Work , schema:Dataset .

hf:Space a owl:Class ;
  rdfs:label "Space"@en ;
  rdfs:comment "A Space — a hosted demo application."@en ;
  rdfs:subClassOf hf:Repository , scholar:Work , schema:SoftwareApplication .

hf:Paper a owl:Class ;
  rdfs:label "Paper"@en ;
  rdfs:comment "An arXiv paper indexed on the Hub (minted at its DataCite DOI IRI https://doi.org/10.48550/arxiv.{id})."@en ;
  rdfs:subClassOf scholar:Work , schema:ScholarlyArticle .

hf:Post a owl:Class ;
  rdfs:label "Post"@en ;
  rdfs:comment "A social post on the Hub feed."@en ;
  rdfs:subClassOf schema:SocialMediaPosting .

#################################################################
#  OBJECT PROPERTIES — authorship & provenance
#################################################################

hf:author a owl:ObjectProperty ;
  rdfs:label "author"@en ;
  rdfs:comment "Repository or post → the account that owns/published it."@en ;
  rdfs:subPropertyOf schema:author .

hf:paperAuthor a owl:ObjectProperty ;
  rdfs:label "paper author (claimed account)"@en ;
  rdfs:comment "Paper → a Hub account claimed/verified as one of its authors."@en ;
  rdfs:subPropertyOf schema:author .

hf:submittedBy a owl:ObjectProperty ;
  rdfs:label "submitted by"@en ;
  rdfs:comment "Paper → the account that submitted it to Daily Papers."@en ;
  rdfs:subPropertyOf schema:contributor .

hf:organization a owl:ObjectProperty ;
  rdfs:label "paper organization"@en ;
  rdfs:comment "Paper → the Hub organization it is associated with."@en ;
  rdfs:subPropertyOf schema:sourceOrganization .

#################################################################
#  OBJECT PROPERTIES — the ML derivation fabric
#################################################################

hf:baseModel a owl:ObjectProperty ;
  rdfs:label "base model"@en ;
  rdfs:comment "Model → the model it derives from (unspecified relation kind)."@en ;
  rdfs:subPropertyOf prov:wasDerivedFrom , schema:isBasedOn .

hf:finetunedFrom a owl:ObjectProperty ;
  rdfs:label "finetuned from"@en ;
  rdfs:subPropertyOf hf:baseModel .

hf:quantizedFrom a owl:ObjectProperty ;
  rdfs:label "quantized from"@en ;
  rdfs:subPropertyOf hf:baseModel .

hf:adapterFor a owl:ObjectProperty ;
  rdfs:label "adapter for"@en ;
  rdfs:comment "Adapter (e.g. LoRA) → the model it adapts."@en ;
  rdfs:subPropertyOf hf:baseModel .

hf:mergedFrom a owl:ObjectProperty ;
  rdfs:label "merged from"@en ;
  rdfs:comment "Merge → one of its ingredient models."@en ;
  rdfs:subPropertyOf hf:baseModel .

hf:trainedOn a owl:ObjectProperty ;
  rdfs:label "trained on"@en ;
  rdfs:comment "Model → a dataset repository used to train or tune it."@en ;
  rdfs:subPropertyOf prov:wasDerivedFrom .

hf:uses a owl:ObjectProperty ;
  rdfs:label "uses"@en ;
  rdfs:comment "Space → a repository it depends on (Hub-computed)."@en ;
  rdfs:subPropertyOf dcterms:requires .

hf:usesModel a owl:ObjectProperty ;
  rdfs:label "uses model"@en ;
  rdfs:subPropertyOf hf:uses .

hf:usesDataset a owl:ObjectProperty ;
  rdfs:label "uses dataset"@en ;
  rdfs:subPropertyOf hf:uses .

hf:citesPaper a owl:ObjectProperty ;
  rdfs:label "cites paper"@en ;
  rdfs:comment "Model or dataset repo → an arXiv paper it references (arxiv: tag)."@en ;
  rdfs:subPropertyOf schema:citation .

#################################################################
#  OBJECT PROPERTIES — the social layer
#################################################################

hf:follows a owl:ObjectProperty ;
  rdfs:label "follows"@en ;
  rdfs:comment "Account → account it follows."@en ;
  rdfs:subPropertyOf sioc:follows .

hf:memberOf a owl:ObjectProperty ;
  rdfs:label "member of"@en ;
  rdfs:comment "User → organization they belong to."@en ;
  rdfs:subPropertyOf org:memberOf .

hf:mentions a owl:ObjectProperty ;
  rdfs:label "mentions"@en ;
  rdfs:comment "Post → an account it mentions."@en ;
  rdfs:subPropertyOf schema:mentions .

#################################################################
#  LINK-OUT PROPERTIES (papers)
#################################################################

hf:githubRepo a owl:ObjectProperty ;
  rdfs:label "GitHub repository"@en ;
  rdfs:subPropertyOf rdfs:seeAlso .

hf:projectPage a owl:ObjectProperty ;
  rdfs:label "project page"@en ;
  rdfs:subPropertyOf rdfs:seeAlso .

hf:hfUrl a owl:ObjectProperty ;
  rdfs:label "Hub page"@en ;
  rdfs:comment "Paper → its huggingface.co/papers page (papers are minted at doi.org)."@en ;
  rdfs:subPropertyOf rdfs:seeAlso .

#################################################################
#  DATATYPE PROPERTIES — identifiers
#################################################################

hf:doi a owl:DatatypeProperty ;
  rdfs:label "DOI"@en ;
  rdfs:comment "The paper's arXiv DataCite DOI (10.48550/arxiv.{id})."@en ;
  rdfs:subPropertyOf scholar:doi .

hf:arxivId a owl:DatatypeProperty ;
  rdfs:label "arXiv id"@en ;
  rdfs:subPropertyOf dcterms:identifier .

hf:repoId a owl:DatatypeProperty ;
  rdfs:label "repo id"@en ;
  rdfs:comment "The Hub repo id, e.g. \"meta-llama/Llama-3.1-8B\"."@en ;
  rdfs:subPropertyOf dcterms:identifier .

hf:accountName a owl:DatatypeProperty ;
  rdfs:label "account name"@en ;
  rdfs:comment "The Hub account handle."@en ;
  rdfs:subPropertyOf dcterms:identifier .

hf:paperswithcodeId a owl:DatatypeProperty ;
  rdfs:label "Papers-with-Code id"@en ;
  rdfs:subPropertyOf dcterms:identifier .

hf:authorName a owl:DatatypeProperty ;
  rdfs:label "author name (unlinked)"@en ;
  rdfs:comment "Paper → a plain author name with no claimed Hub account."@en .

#################################################################
#  DATATYPE PROPERTIES — descriptive
#################################################################

hf:pipelineTag a owl:DatatypeProperty ;
  rdfs:label "pipeline tag"@en ;
  rdfs:comment "Task, e.g. text-generation, image-classification."@en .

hf:library a owl:DatatypeProperty ;
  rdfs:label "library"@en ;
  rdfs:comment "Primary library, e.g. transformers, diffusers."@en .

hf:sdk a owl:DatatypeProperty ;
  rdfs:label "space SDK"@en ;
  rdfs:comment "gradio | streamlit | docker | static."@en .

hf:inferenceProvider a owl:DatatypeProperty ;
  rdfs:label "inference provider"@en ;
  rdfs:comment "A provider serving this model (from the provider mapping)."@en .

hf:gated a owl:DatatypeProperty ;
  rdfs:label "gated"@en ;
  rdfs:comment "Access gating: auto | manual (absent = open)."@en .

hf:isPro a owl:DatatypeProperty ; rdfs:label "PRO account"@en .
hf:isVerified a owl:DatatypeProperty ; rdfs:label "verified org"@en .
hf:plan a owl:DatatypeProperty ; rdfs:label "org plan"@en .
hf:sha a owl:DatatypeProperty ; rdfs:label "head commit sha"@en .
hf:subdomain a owl:DatatypeProperty ; rdfs:label "space subdomain"@en .
hf:hasGguf a owl:DatatypeProperty ;
  rdfs:label "has GGUF weights"@en .

#################################################################
#  DATATYPE PROPERTIES — metrics (xsd:integer / xsd:double)
#################################################################

hf:likes a owl:DatatypeProperty ; rdfs:label "likes"@en .
hf:downloads a owl:DatatypeProperty ;
  rdfs:label "downloads (30-day)"@en .
hf:downloadsAllTime a owl:DatatypeProperty ;
  rdfs:label "downloads (all time)"@en .
hf:trendingScore a owl:DatatypeProperty ; rdfs:label "trending score"@en .
hf:parameterCount a owl:DatatypeProperty ;
  rdfs:label "parameter count"@en ;
  rdfs:comment "Total parameters from the safetensors metadata."@en .
hf:upvotes a owl:DatatypeProperty ; rdfs:label "paper upvotes"@en .
hf:followerCount a owl:DatatypeProperty ; rdfs:label "followers"@en .
hf:followingCount a owl:DatatypeProperty ; rdfs:label "following"@en .
hf:modelCount a owl:DatatypeProperty ; rdfs:label "models owned"@en .
hf:datasetCount a owl:DatatypeProperty ; rdfs:label "datasets owned"@en .
hf:spaceCount a owl:DatatypeProperty ; rdfs:label "spaces owned"@en .
hf:paperCount a owl:DatatypeProperty ; rdfs:label "papers claimed"@en .
hf:bucketCount a owl:DatatypeProperty ;
  rdfs:label "storage buckets"@en ;
  rdfs:comment "Count only — the Hub has no public bucket-listing API."@en .
hf:kernelCount a owl:DatatypeProperty ; rdfs:label "kernels"@en .
hf:discussionCount a owl:DatatypeProperty ; rdfs:label "discussions"@en .
hf:upvoteCount a owl:DatatypeProperty ; rdfs:label "upvotes received"@en .
hf:likeCount a owl:DatatypeProperty ; rdfs:label "likes given"@en .
hf:memberCount a owl:DatatypeProperty ; rdfs:label "org members"@en .
hf:impressions a owl:DatatypeProperty ; rdfs:label "post impressions"@en .

#################################################################
#  FULL-FIDELITY EXTENSION  (build_nt.py --full / hugging-face-full)
#
#  Terms used only by the full build, which carries EVERY column of
#  the source parquets. Three open-ended key namespaces hold the
#  path-flattened JSON blobs — their properties are minted from the
#  source keys themselves, so they are not enumerated here:
#    https://w3id.org/rete/huggingface/card#{key}    repo card metadata
#    https://w3id.org/rete/huggingface/config#{key}  model config
#    https://w3id.org/rete/huggingface/gguf#{key}    GGUF metadata
#    https://w3id.org/rete/huggingface/param#{dtype} parameters per dtype
#  Each blob is ALSO kept verbatim (hf:cardDataJson / configJson /
#  ggufJson) so the flattening is additive and nothing is lost.
#################################################################

hf:file a owl:DatatypeProperty ;
  rdfs:label "file"@en ;
  rdfs:comment "A path in the repository's file manifest. A literal, not a node: the source carries only the filename, and ~97M entries share ~36M distinct values."@en .

hf:cardDataJson a owl:DatatypeProperty ;
  rdfs:label "card metadata (raw JSON)"@en ;
  rdfs:comment "The repo card front-matter verbatim; also flattened under the card# namespace."@en .
hf:configJson a owl:DatatypeProperty ;
  rdfs:label "model config (raw JSON)"@en .
hf:ggufJson a owl:DatatypeProperty ;
  rdfs:label "GGUF metadata (raw JSON)"@en .

hf:InferenceOffer a owl:Class ;
  rdfs:label "inference offer"@en ;
  rdfs:comment "One provider serving one model, with its status, task, pricing and measured performance."@en ;
  rdfs:subClassOf schema:Offer .

hf:inferenceOffer a owl:ObjectProperty ;
  rdfs:label "inference offer"@en ;
  rdfs:subPropertyOf schema:offers .

hf:provider a owl:DatatypeProperty ; rdfs:label "provider"@en .
hf:providerId a owl:DatatypeProperty ; rdfs:label "provider-side model id"@en .
hf:providerStatus a owl:DatatypeProperty ; rdfs:label "provider status"@en .
hf:providerTask a owl:DatatypeProperty ; rdfs:label "provider task"@en .
hf:providerType a owl:DatatypeProperty ; rdfs:label "provider mapping type"@en .
hf:providerAdapter a owl:DatatypeProperty ; rdfs:label "adapter kind"@en .
hf:providerAdapterWeightsPath a owl:DatatypeProperty ; rdfs:label "adapter weights path"@en .
hf:providerPreviousStatus a owl:DatatypeProperty ; rdfs:label "previous status"@en .
hf:structuredOutput a owl:DatatypeProperty ; rdfs:label "supports structured output"@en .
hf:toolCalling a owl:DatatypeProperty ; rdfs:label "supports tool calling"@en .
hf:requestLatencyMs a owl:DatatypeProperty ; rdfs:label "request latency (ms)"@en .
hf:firstTokenLatencyMs a owl:DatatypeProperty ; rdfs:label "first-token latency (ms)"@en .
hf:tokensPerSecond a owl:DatatypeProperty ; rdfs:label "tokens per second"@en .
hf:numGeneratedTokens a owl:DatatypeProperty ; rdfs:label "generated tokens (benchmark)"@en .
hf:contextLength a owl:DatatypeProperty ; rdfs:label "context length"@en .
hf:pricingInput a owl:DatatypeProperty ; rdfs:label "price per input token"@en .
hf:pricingOutput a owl:DatatypeProperty ; rdfs:label "price per output token"@en .
hf:isModelAuthor a owl:DatatypeProperty ; rdfs:label "provider is the model author"@en .

hf:hubId a owl:DatatypeProperty ;
  rdfs:label "Hub internal id"@en ;
  rdfs:subPropertyOf dcterms:identifier .
hf:citation a owl:DatatypeProperty ;
  rdfs:label "citation (BibTeX)"@en ;
  rdfs:subPropertyOf dcterms:bibliographicCitation .
hf:disabled a owl:DatatypeProperty ; rdfs:label "disabled"@en .
hf:private a owl:DatatypeProperty ; rdfs:label "private"@en .

hf:autoModel a owl:DatatypeProperty ; rdfs:label "transformers auto-model class"@en .
hf:transformersPipelineTag a owl:DatatypeProperty ; rdfs:label "transformers pipeline tag"@en .
hf:processor a owl:DatatypeProperty ; rdfs:label "transformers processor"@en .
hf:customClass a owl:DatatypeProperty ; rdfs:label "custom model class"@en .

hf:aiSummary a owl:DatatypeProperty ; rdfs:label "AI-written summary"@en .
hf:aiSummaryModel a owl:DatatypeProperty ; rdfs:label "model that wrote the summary"@en .
hf:aiKeyword a owl:DatatypeProperty ; rdfs:label "AI-extracted keyword"@en .
hf:mediaUrl a owl:ObjectProperty ; rdfs:label "media"@en ; rdfs:subPropertyOf schema:associatedMedia .
hf:thumbnail a owl:DatatypeProperty ; rdfs:label "thumbnail"@en .
hf:discussionId a owl:DatatypeProperty ; rdfs:label "discussion id"@en .
hf:githubStars a owl:DatatypeProperty ; rdfs:label "GitHub stars"@en .
hf:githubRepoAddedBy a owl:DatatypeProperty ; rdfs:label "GitHub repo added by"@en .
hf:submittedOnDailyAt a owl:DatatypeProperty ; rdfs:label "submitted to Daily Papers at"@en .
hf:withdrawnAt a owl:DatatypeProperty ; rdfs:label "withdrawn at"@en .
hf:authorParticipating a owl:DatatypeProperty ; rdfs:label "an author joined the discussion"@en .
hf:commentCount a owl:DatatypeProperty ; rdfs:label "comments"@en .

hf:slug a owl:DatatypeProperty ; rdfs:label "post slug"@en .
hf:contentValue a owl:DatatypeProperty ; rdfs:label "post content block (text)"@en .
hf:contentCode a owl:DatatypeProperty ; rdfs:label "post content block (code)"@en .
hf:contentHref a owl:DatatypeProperty ; rdfs:label "post content link"@en .
hf:contentUrl a owl:DatatypeProperty ; rdfs:label "post content URL"@en .
hf:contentImage a owl:DatatypeProperty ; rdfs:label "post content image"@en .
hf:contentLabel a owl:DatatypeProperty ; rdfs:label "post content label"@en .
hf:referencesRepo a owl:DatatypeProperty ; rdfs:label "repo referenced in a post"@en .
hf:reaction a owl:DatatypeProperty ;
  rdfs:label "reaction"@en ;
  rdfs:comment "\"{emoji}:{count}\" — the reaction and how many gave it."@en .
hf:reactedBy a owl:ObjectProperty ; rdfs:label "reacted by"@en .
hf:commentedBy a owl:ObjectProperty ; rdfs:label "commented by"@en .
