@prefix ethz:    <https://w3id.org/rete/ethz#> .
@prefix scholar: <https://w3id.org/rete/scholar#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix org:     <http://www.w3.org/ns/org#> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix fabio:   <http://purl.org/spar/fabio/> .
@prefix frapo:   <http://purl.org/cerif/frapo/> .

#################################################################
#  ETH Research Collection ontology  (https://w3id.org/rete/ethz#)
#
#  Models the ETH Zürich institutional repository (DSpace 7.6) as a
#  scholarly graph and aligns it to the shared rete Scholarly-Graph hub
#  (scholar:) so it federates for free with DBLP / OpenAIRE / DataCite /
#  OpenCitations / ORCID / ROR / Crossref on shared PIDs.
#
#  Canonical instance-IRI policy (applied by xoai_to_nt.py):
#    • Work with an ETH/external DOI → https://doi.org/{doi}   (bare, lowercased)
#    • Work without a DOI            → https://hdl.handle.net/{handle}
#    • Person with an ORCID          → https://orcid.org/{orcid}
#    • Person without an ORCID       → https://w3id.org/rete/ethz/person/{name-slug}
#    • Serial with an ISSN           → https://portal.issn.org/resource/ISSN/{issn}
#    • ETH org unit (Leitzahl code)  → https://w3id.org/rete/ethz/unit/{code}
#    • Bitstream (file)              → https://w3id.org/rete/ethz/bitstream/{uuid}
#    • DSpace relationship target    → https://w3id.org/rete/ethz/entity/{uuid}
#
#  OWL 2 QL-safe (subClassOf / subPropertyOf / domain / range only).
#################################################################

ethz: a owl:Ontology ;
  dcterms:title "ETH Research Collection ontology"@en ;
  dcterms:description "Ontology for the ETH Zürich Research Collection (DSpace 7.6) as a scholarly knowledge graph: publications and research data, their authors, journals, ETH affiliation tree, grants, external identifiers, the DSpace entity-relationship graph, and the file manifest (bitstreams). Aligned to the rete scholarly hub (scholar:)."@en ;
  dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
  rdfs:seeAlso scholar: ;
  owl:versionInfo "1.0.0 (2026-07-24)" .

#################################################################
#  CLASSES
#################################################################

ethz:Item a owl:Class ;
  rdfs:label "Repository item"@en ;
  rdfs:comment "Any item in the ETH Research Collection."@en ;
  rdfs:subClassOf scholar:Work .

ethz:Publication a owl:Class ;
  rdfs:label "Publication"@en ;
  rdfs:subClassOf ethz:Item .

ethz:ResearchData a owl:Class ;
  rdfs:label "Research data"@en ;
  rdfs:comment "A research-data item (dspace.entity.type = ResearchData)."@en ;
  rdfs:subClassOf ethz:Item .

# Per-publication-type leaf classes (dc.type). Declared subClassOf ethz:Publication
# so the type pyramid has meaningful communities. (ResearchData types fall under
# ethz:ResearchData via the converter.)
ethz:JournalArticle       a owl:Class ; rdfs:label "Journal Article"@en ;       rdfs:subClassOf ethz:Publication .
ethz:ConferencePaper      a owl:Class ; rdfs:label "Conference Paper"@en ;      rdfs:subClassOf ethz:Publication .
ethz:DoctoralThesis       a owl:Class ; rdfs:label "Doctoral Thesis"@en ;       rdfs:subClassOf ethz:Publication .
ethz:MasterThesis         a owl:Class ; rdfs:label "Master Thesis"@en ;         rdfs:subClassOf ethz:Publication .
ethz:BookChapter          a owl:Class ; rdfs:label "Book Chapter"@en ;          rdfs:subClassOf ethz:Publication .
ethz:Report               a owl:Class ; rdfs:label "Report"@en ;               rdfs:subClassOf ethz:Publication .
ethz:WorkingPaper         a owl:Class ; rdfs:label "Working Paper"@en ;         rdfs:subClassOf ethz:Publication .
ethz:ReviewArticle        a owl:Class ; rdfs:label "Review Article"@en ;        rdfs:subClassOf ethz:Publication .
ethz:Presentation         a owl:Class ; rdfs:label "Presentation"@en ;          rdfs:subClassOf ethz:Publication .
ethz:Monograph            a owl:Class ; rdfs:label "Monograph"@en ;             rdfs:subClassOf ethz:Publication .
ethz:Dataset              a owl:Class ; rdfs:label "Dataset"@en ;               rdfs:subClassOf ethz:ResearchData .
ethz:OtherPublication     a owl:Class ; rdfs:label "Other Publication"@en ;     rdfs:subClassOf ethz:Publication .

ethz:Person a owl:Class ;
  rdfs:label "Person"@en ;
  rdfs:comment "An author, editor or supervisor of an ETH Research Collection item."@en ;
  rdfs:subClassOf scholar:Person .

ethz:OrgUnit a owl:Class ;
  rdfs:label "ETH organisational unit"@en ;
  rdfs:comment "A node of the ETH Leitzahl affiliation tree (department, institute, chair/group)."@en ;
  rdfs:subClassOf scholar:Organization .

ethz:Journal a owl:Class ;
  rdfs:label "Journal / serial"@en ;
  rdfs:subClassOf fabio:Journal .

ethz:Grant a owl:Class ;
  rdfs:label "Grant"@en ;
  rdfs:subClassOf scholar:Grant .

ethz:File a owl:Class ;
  rdfs:label "File (bitstream)"@en ;
  rdfs:comment "An ORIGINAL-bundle bitstream (the deposited file). Metadata only — name, MIME, size, MD5 checksum, download URL; the bytes are NOT part of this dataset."@en ;
  rdfs:subClassOf fabio:DigitalManifestation .

ethz:Entity a owl:Class ;
  rdfs:label "DSpace related entity"@en ;
  rdfs:comment "An opaque target of a DSpace relationship, identified only by its entity UUID (xoai does not expose the target's handle/DOI). A future REST pass could resolve these to ethz:Item IRIs."@en .

#################################################################
#  OBJECT PROPERTIES
#################################################################

ethz:creator a owl:ObjectProperty ;
  rdfs:label "creator / author"@en ; rdfs:domain ethz:Item ; rdfs:range ethz:Person ;
  rdfs:subPropertyOf dcterms:creator .
ethz:editor a owl:ObjectProperty ;
  rdfs:label "editor"@en ; rdfs:domain ethz:Item ; rdfs:range ethz:Person ;
  rdfs:subPropertyOf dcterms:contributor .
ethz:supervisor a owl:ObjectProperty ;
  rdfs:label "supervisor"@en ; rdfs:domain ethz:Item ; rdfs:range ethz:Person ;
  rdfs:subPropertyOf dcterms:contributor .
ethz:journal a owl:ObjectProperty ;
  rdfs:label "published in journal/serial"@en ; rdfs:domain ethz:Item ; rdfs:range ethz:Journal ;
  rdfs:subPropertyOf dcterms:isPartOf .
ethz:affiliation a owl:ObjectProperty ;
  rdfs:label "ETH affiliation unit"@en ; rdfs:domain ethz:Item ; rdfs:range ethz:OrgUnit .
ethz:funding a owl:ObjectProperty ;
  rdfs:label "funded by grant"@en ; rdfs:domain ethz:Item ; rdfs:range ethz:Grant .
ethz:hasFile a owl:ObjectProperty ;
  rdfs:label "has file"@en ; rdfs:domain ethz:Item ; rdfs:range ethz:File .
ethz:funder a owl:ObjectProperty ;
  rdfs:label "funder"@en ; rdfs:domain ethz:Grant ; rdfs:range scholar:Funder .

# DSpace entity-relationship graph (targets are ethz:Entity UUID nodes).
ethz:relatedEntity a owl:ObjectProperty ;
  rdfs:label "related DSpace entity"@en ; rdfs:domain ethz:Item ; rdfs:range ethz:Entity ;
  rdfs:comment "Super-property of the specific DSpace relationships (version chains, citations, parts, supplements, research-data links)."@en .
ethz:isNewVersionOf     a owl:ObjectProperty ; rdfs:label "is new version of"@en ;     rdfs:subPropertyOf ethz:relatedEntity .
ethz:isPreviousVersionOf a owl:ObjectProperty ; rdfs:label "is previous version of"@en ; rdfs:subPropertyOf ethz:relatedEntity .
ethz:cites              a owl:ObjectProperty ; rdfs:label "cites"@en ;                  rdfs:subPropertyOf ethz:relatedEntity .
ethz:isCitedBy          a owl:ObjectProperty ; rdfs:label "is cited by"@en ;            rdfs:subPropertyOf ethz:relatedEntity .
ethz:references         a owl:ObjectProperty ; rdfs:label "references"@en ;             rdfs:subPropertyOf ethz:relatedEntity .
ethz:isReferencedBy     a owl:ObjectProperty ; rdfs:label "is referenced by"@en ;       rdfs:subPropertyOf ethz:relatedEntity .
ethz:hasPart            a owl:ObjectProperty ; rdfs:label "has part"@en ;               rdfs:subPropertyOf ethz:relatedEntity .
ethz:isPartOf           a owl:ObjectProperty ; rdfs:label "is part of (entity)"@en ;    rdfs:subPropertyOf ethz:relatedEntity .
ethz:isSupplementTo     a owl:ObjectProperty ; rdfs:label "is supplement to"@en ;       rdfs:subPropertyOf ethz:relatedEntity .
ethz:isSupplementedBy   a owl:ObjectProperty ; rdfs:label "is supplemented by"@en ;     rdfs:subPropertyOf ethz:relatedEntity .

org:subOrganizationOf a owl:ObjectProperty .

#################################################################
#  DATATYPE PROPERTIES
#################################################################

ethz:handle a owl:DatatypeProperty ;
  rdfs:label "Handle"@en ; rdfs:domain ethz:Item ; rdfs:range xsd:string .
ethz:doi a owl:DatatypeProperty ;
  rdfs:label "DOI"@en ; rdfs:domain ethz:Item ; rdfs:range xsd:string ;
  rdfs:subPropertyOf scholar:doi .
ethz:arxiv a owl:DatatypeProperty ;
  rdfs:label "arXiv id"@en ; rdfs:range xsd:string .
ethz:wos a owl:DatatypeProperty ;
  rdfs:label "Web of Science id"@en ; rdfs:range xsd:string .
ethz:scopus a owl:DatatypeProperty ;
  rdfs:label "Scopus id"@en ; rdfs:range xsd:string .
ethz:pmid a owl:DatatypeProperty ;
  rdfs:label "PMID"@en ; rdfs:range xsd:string ; rdfs:subPropertyOf scholar:pmid .
ethz:isbn a owl:DatatypeProperty ;
  rdfs:label "ISBN"@en ; rdfs:range xsd:string ; rdfs:subPropertyOf scholar:isbn .
ethz:issn a owl:DatatypeProperty ;
  rdfs:label "ISSN"@en ; rdfs:range xsd:string .
ethz:nebis a owl:DatatypeProperty ;
  rdfs:label "NEBIS id"@en ; rdfs:range xsd:string .
ethz:orcid a owl:DatatypeProperty ;
  rdfs:label "ORCID iD"@en ; rdfs:domain ethz:Person ; rdfs:range xsd:string ;
  rdfs:subPropertyOf scholar:orcid .
ethz:publicationType a owl:DatatypeProperty ;
  rdfs:label "publication type"@en ; rdfs:range xsd:string .
ethz:availability a owl:DatatypeProperty ;
  rdfs:label "availability"@en ; rdfs:range xsd:string ;
  rdfs:comment "Open access / Metadata only / Closed access / Embargoed / ETHZ users."@en .
ethz:leitzahlCode a owl:DatatypeProperty ;
  rdfs:label "Leitzahl code"@en ; rdfs:domain ethz:OrgUnit ; rdfs:range xsd:string .
ethz:ddc a owl:DatatypeProperty ;
  rdfs:label "Dewey Decimal code"@en ; rdfs:range xsd:string .
ethz:jel a owl:DatatypeProperty ;
  rdfs:label "JEL code"@en ; rdfs:range xsd:string .
ethz:sizeBytes a owl:DatatypeProperty ;
  rdfs:label "file size (bytes)"@en ; rdfs:domain ethz:File ; rdfs:range xsd:integer .
ethz:checksum a owl:DatatypeProperty ;
  rdfs:label "checksum"@en ; rdfs:domain ethz:File ; rdfs:range xsd:string .
ethz:checksumAlgorithm a owl:DatatypeProperty ;
  rdfs:label "checksum algorithm"@en ; rdfs:domain ethz:File ; rdfs:range xsd:string .
ethz:downloadURL a owl:DatatypeProperty ;
  rdfs:label "download URL"@en ; rdfs:domain ethz:File ; rdfs:range xsd:anyURI .
ethz:bundle a owl:DatatypeProperty ;
  rdfs:label "DSpace bundle"@en ; rdfs:domain ethz:File ; rdfs:range xsd:string .
