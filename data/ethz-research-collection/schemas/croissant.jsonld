   "encodingFormat": "application/x-parquet",
   "sha256": "unknown"
  },
  {
   "@type": "cr:FileObject",
   "@id": "journals.parquet",
   "name": "journals.parquet",
   "description": "Serials/journals (one row per journal), ISSN-identified where available.",
   "contentUrl": "https://data.graphplaza.com/ethz-research-collection/ethz-research-collection-tables/journals.parquet",
   "encodingFormat": "application/x-parquet",
   "sha256": "unknown"
  },
  {
   "@type": "cr:FileObject",
   "@id": "persons.parquet",
   "name": "persons.parquet",
   "description": "Authors, editors and supervisors (one row per person). ORCID-identified people are minted at https://orcid.org/{orcid}.",
   "contentUrl": "https://data.graphplaza.com/ethz-research-collection/ethz-research-collection-tables/persons.parquet",
   "encodingFormat": "application/x-parquet",
   "sha256": "unknown"
  },
  {
   "@type": "cr:FileObject",
   "@id": "triples.parquet",
