 "@type": "Dataset",
 "conformsTo": "http://mlcommons.org/croissant/1.0",
 "name": "ethz-research-collection",
 "description": "ETH Zürich Research Collection (DSpace 7.6) scholarly graph — per-class entity tables (works, persons, files, journals, grants, units) plus the flat triples table. Companions to the ethz-research-collection.rete graph; aligned to the rete scholar hub via canonical DOI/ORCID/ISSN IRIs.",
 "url": "https://www.research-collection.ethz.ch/",
 "license": "https://creativecommons.org/publicdomain/zero/1.0/",
 "version": "1.0.0",
 "citeAs": "ETH Research Collection (research-collection.ethz.ch), harvested via OAI-PMH.",
 "datePublished": "2026-07-23",
 "distribution": [
  {
   "@type": "cr:FileObject",
   "@id": "files.parquet",
   "name": "files.parquet",
   "description": "The ORIGINAL-bundle file manifest — one row per deposited bitstream: name, MIME, size (bytes), MD5 checksum, download URL, bundle. Metadata only; no bytes.",
   "contentUrl": "https://data.graphplaza.com/ethz-research-collection/ethz-research-collection-tables/files.parquet",
   "encodingFormat": "application/x-parquet",
   "sha256": "unknown"
  },
  {
   "@type": "cr:FileObject",
   "@id": "grants.parquet",
   "name": "grants.parquet",
   "description": "Grants funding the works (name, identifier, programme).",
